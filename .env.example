# SalesIQ Environment Configuration Template
# Copy this file to .env and modify values as needed

# Application
APP_ENV=development
APP_DEBUG=True
APP_HOST=localhost
APP_PORT=8501

# Database
DATABASE_URL=sqlite:///salesiq.db
# For PostgreSQL: postgresql://user:password@localhost/salesiq

# Feature Flags
FEATURE_DARK_MODE=False
FEATURE_REAL_TIME_UPDATES=False
FEATURE_ADVANCED_ANALYTICS=True
FEATURE_ML_FORECASTING=True
FEATURE_REPORT_GENERATION=True
FEATURE_DATA_UPLOAD=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/salesiq.log

# Data
DATA_PATH=data/
SAMPLE_DATA_FILE=sample_sales.csv

# Forecasting
FORECAST_PERIODS=30
TEST_SIZE=0.2

# Security
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# API Configuration (for future integrations)
API_TIMEOUT=30
API_RETRY_COUNT=3
